{
  // Eve Marly : site statique (dossier src) + Worker (visites, catalogue dynamique, administration)
  "name": "eve-marley",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/produit/*"]
  },
  // Base de données intégrée (Durable Object SQLite) : créée automatiquement au déploiement
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
